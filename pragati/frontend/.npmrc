# npm reads .npmrc from the directory it installs in — this must sit next to
# package.json, NOT in public/ (public/ is copied verbatim into dist/ and is
# never consulted by npm).
#
# engine-strict keeps Vercel honest about the Node version in .nvmrc.
engine-strict=false
fund=false
audit=false

# Peer dependencies are now genuinely satisfied (R3F 8.x / drei 9.x are the
# React 18 line), so the resolver is left in strict mode on purpose: a future
# `npm install` of a React-19-only package should fail loudly here rather than
# silently produce a broken tree that only breaks on Vercel.
#
# If you deliberately need to force an install past a peer conflict, uncomment:
# legacy-peer-deps=true
