{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": [
    {
      "name": "frontend",
      "build": {
        "command": "cd frontend && npm run build",
        "outputDirectory": "frontend/dist"
      }
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
